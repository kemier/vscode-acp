{
  "name": "acp-client",
  "displayName": "ACP Client",
  "description": "Agent Client Protocol client for VS Code \u2014 connect to GitHub Copilot, Claude Code, Gemini CLI, Qwen Code, Codex CLI, OpenCode, OpenClaw, Kiro CLI, Hermes Agent, and any ACP-compatible AI coding agent",
  "version": "0.3.5",
  "publisher": "formulahendry",
  "license": "MIT",
  "icon": "resources/icon.png",
  "bugs": {
    "url": "https://github.com/formulahendry/vscode-acp/issues",
    "email": "formulahendry@gmail.com"
  },
  "homepage": "https://github.com/formulahendry/vscode-acp/blob/main/README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/formulahendry/vscode-acp.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "acp",
    "agent",
    "ai",
    "coding agent",
    "copilot"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "acp-client",
          "title": "ACP Client",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "acp-client": [
        {
          "id": "acp-sessions",
          "name": "Agents",
          "type": "tree"
        },
        {
          "id": "acp-chat",
          "name": "Chat",
          "type": "webview"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "acp-sessions",
        "contents": "No agents configured.\n[Add Agent](command:acp.addAgent)\nConfigure agents in settings or browse the [Agent Registry](command:acp.browseRegistry)."
      }
    ],
    "commands": [
      {
        "command": "acp.connectAgent",
        "title": "ACP: Connect to Agent",
        "icon": "$(plug)"
      },
      {
        "command": "acp.newConversation",
        "title": "ACP: New Conversation",
        "icon": "$(add)"
      },
      {
        "command": "acp.sendPrompt",
        "title": "ACP: Send Prompt"
      },
      {
        "command": "acp.cancelTurn",
        "title": "ACP: Cancel Current Turn",
        "icon": "$(debug-stop)"
      },
      {
        "command": "acp.toggleFollowAgent",
        "title": "ACP: Toggle Follow Agent",
        "icon": "$(target)"
      },
      {
        "command": "acp.disconnectAgent",
        "title": "ACP: Disconnect Agent",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "acp.openChat",
        "title": "ACP: Open Chat Panel"
      },
      {
        "command": "acp.addAgent",
        "title": "ACP: Add Agent Configuration",
        "icon": "$(add)"
      },
      {
        "command": "acp.removeAgent",
        "title": "ACP: Remove Agent"
      },
      {
        "command": "acp.showLog",
        "title": "ACP: Show Log"
      },
      {
        "command": "acp.showTraffic",
        "title": "ACP: Show Protocol Traffic"
      },
      {
        "command": "acp.exportTraffic",
        "title": "ACP: Export Protocol Traffic"
      },
      {
        "command": "acp.showMemoryStatus",
        "title": "ACP: Show Shared Memory Status"
      },
      {
        "command": "acp.browseRegistry",
        "title": "ACP: Browse Agent Registry"
      },
      {
        "command": "acp.setMode",
        "title": "ACP: Set Agent Mode"
      },
      {
        "command": "acp.setModel",
        "title": "ACP: Set Agent Model"
      },
      {
        "command": "acp.attachFile",
        "title": "ACP: Attach File to Prompt",
        "icon": "$(attach)"
      },
      {
        "command": "acp.refreshAgents",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "acp.refreshSessions",
        "title": "ACP: Refresh Sessions"
      },
      {
        "command": "acp.openSession",
        "title": "ACP: Open Session"
      },
      {
        "command": "acp.loadMoreSessions",
        "title": "ACP: Load More Sessions"
      },
      {
        "command": "acp.copySessionId",
        "title": "Copy Session ID"
      },
      {
        "command": "acp.forgetSession",
        "title": "Forget Session"
      },
      {
        "command": "acp.deleteSession",
        "title": "Delete Session (Agent)"
      },
      {
        "command": "acp.logout",
        "title": "ACP: Logout Agent"
      },
      {
        "command": "acp.forkSession",
        "title": "ACP: Fork Session"
      },
      {
        "command": "acp.forkToAgent",
        "title": "ACP: Fork to Another Agent"
      },
      {
        "command": "acp.restartAgent",
        "title": "ACP: Restart Agent",
        "icon": "$(debug-restart)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "acp.openSession",
          "when": "false"
        },
        {
          "command": "acp.loadMoreSessions",
          "when": "false"
        },
        {
          "command": "acp.copySessionId",
          "when": "false"
        },
        {
          "command": "acp.forgetSession",
          "when": "false"
        },
        {
          "command": "acp.deleteSession",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "acp.addAgent",
          "when": "view == acp-sessions",
          "group": "navigation@1"
        },
        {
          "command": "acp.refreshAgents",
          "when": "view == acp-sessions",
          "group": "navigation@2"
        },
        {
          "command": "acp.browseRegistry",
          "when": "view == acp-sessions"
        },
        {
          "command": "acp.newConversation",
          "when": "view == acp-chat",
          "group": "navigation@1"
        },
        {
          "command": "acp.attachFile",
          "when": "view == acp-chat",
          "group": "navigation@2"
        },
        {
          "command": "acp.cancelTurn",
          "when": "view == acp-chat && acp.turnInProgress",
          "group": "navigation@3"
        },
        {
          "command": "acp.disconnectAgent",
          "when": "view == acp-chat",
          "group": "navigation@4"
        },
        {
          "command": "acp.showLog",
          "when": "view == acp-chat"
        },
        {
          "command": "acp.showTraffic",
          "when": "view == acp-chat"
        },
        {
          "command": "acp.restartAgent",
          "when": "view == acp-chat"
        }
      ],
      "view/item/context": [
        {
          "command": "acp.connectAgent",
          "when": "view == acp-sessions && viewItem == agent-disconnected",
          "group": "inline"
        },
        {
          "command": "acp.disconnectAgent",
          "when": "view == acp-sessions && viewItem == agent-connected",
          "group": "inline"
        },
        {
          "command": "acp.refreshSessions",
          "when": "view == acp-sessions && (viewItem == agent-connected || viewItem == agent-disconnected)",
          "group": "session@1"
        },
        {
          "command": "acp.removeAgent",
          "when": "view == acp-sessions && (viewItem == agent-connected || viewItem == agent-disconnected)",
          "group": "1_modification@0"
        },
        {
          "command": "acp.restartAgent",
          "when": "view == acp-sessions && viewItem == agent-connected",
          "group": "1_modification@1"
        },
        {
          "command": "acp.logout",
          "when": "view == acp-sessions && viewItem == agent-connected",
          "group": "1_modification@2"
        },
        {
          "command": "acp.copySessionId",
          "when": "view == acp-sessions && (viewItem =~ /^session/ || viewItem == local-no-delete)",
          "group": "session@1"
        },
        {
          "command": "acp.forgetSession",
          "when": "view == acp-sessions && viewItem == local-no-delete",
          "group": "session@2"
        },
        {
          "command": "acp.deleteSession",
          "when": "view == acp-sessions && viewItem =~ /^session/",
          "group": "session@2"
        },
        {
          "command": "acp.forkSession",
          "when": "view == acp-sessions && viewItem =~ /^session.*-fork$/",
          "group": "session@3"
        },
        {
          "command": "acp.forkToAgent",
          "when": "view == acp-sessions && (viewItem =~ /^session/ || viewItem == local-no-delete || viewItem == session-local-no-delete)",
          "group": "session@4"
        }
      ]
    },
    "keybindings": [
      {
        "command": "acp.openChat",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a"
      },
      {
        "command": "acp.cancelTurn",
        "key": "escape",
        "when": "acp.turnInProgress"
      }
    ],
    "configuration": {
      "title": "ACP Client",
      "properties": {
        "acp.agents": {
          "type": "object",
          "description": "Agent configurations. Each key is the agent name, value has command, args, and env.",
          "default": {}
        },
        "acp.autoApprovePermissions": {
          "type": "string",
          "enum": [
            "ask",
            "allowAll",
            "remember"
          ],
          "default": "remember",
          "description": "Automatically approve agent permission requests. 'ask' always prompts, 'allowAll' approves everything, 'remember' auto-approves commands and tools you have approved before (persisted across sessions)."
        },
        "acp.approvedCommands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "List of normalized commands that have been approved by the user and will be auto-approved in 'remember' mode."
        },
        "acp.approvedTools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Fingerprints of non-command tools (e.g. Kiro subagent crew) approved via allow_always / remember. Survives VS Code reload."
        },
        "acp.deniedCommands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "List of command prefixes that are always denied (auto-rejected). Merged with built-in denylist (rm -rf, sudo, etc.)."
        },
        "acp.defaultWorkingDirectory": {
          "type": "string",
          "default": "",
          "description": "Default working directory for agent sessions. Leave empty to use the current workspace folder."
        },
        "acp.logTraffic": {
          "type": "boolean",
          "default": true,
          "description": "Log all ACP protocol traffic to the output channel."
        },
        "acp.logTrafficMaxEntries": {
          "type": "number",
          "default": 1000,
          "minimum": 50,
          "description": "Maximum number of entries kept in the ACP Traffic output channel before it is cleared. Prevents unbounded memory growth in long sessions."
        },
        "acp.sessionSummary.endpoint": {
          "type": "string",
          "default": "http://127.0.0.1:8317",
          "description": "responses-vllm-proxy base URL for /session summarization (POST /v1/summarize-session). Matches Pi vllm-proxy provider baseUrl without /v1."
        },
        "acp.sessionSummary.apiKey": {
          "type": "string",
          "default": "",
          "description": "Optional Bearer token for the vLLM proxy when api-keys are enabled."
        },
        "acp.sessionSummary.timeoutMs": {
          "type": "number",
          "default": 120000,
          "minimum": 5000,
          "description": "HTTP timeout for /session summarization requests (milliseconds)."
        },
        "acp.memory.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable TencentDB Agent Memory (Model B): shared team memory with per-agent profiles (codex/claude/kiro/\u2026). Requires a running MemoryCore Gateway."
        },
        "acp.memory.endpoint": {
          "type": "string",
          "default": "http://127.0.0.1:8420",
          "description": "MemoryCore Gateway base URL (no trailing slash)."
        },
        "acp.memory.apiKey": {
          "type": "string",
          "default": "",
          "description": "Bearer token for MemoryCore Gateway (TDAI_GATEWAY_API_KEY)."
        },
        "acp.memory.serviceId": {
          "type": "string",
          "default": "default",
          "description": "Memory instance / space id (x-tdai-service-id). Shared by all ACP agents."
        },
        "acp.memory.teamId": {
          "type": "string",
          "default": "default",
          "description": "Team id for Model B isolation. Shared by all ACP agents so team-visible Skills/Knowledge can be shared."
        },
        "acp.memory.userId": {
          "type": "string",
          "default": "",
          "description": "User id for memory isolation. Empty = OS username."
        },
        "acp.memory.agentIdMap": {
          "type": "object",
          "default": {},
          "description": "Optional map of ACP agent config name \u2192 MemoryCore agent_id. Unmapped names use built-in heuristics (Codex\u2192codex, Claude\u2192claude, Kiro\u2192kiro, \u2026)."
        },
        "acp.memory.recallMaxResults": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 50,
          "description": "Max L1 atomic memories to inject on each prompt."
        },
        "acp.memory.includePersona": {
          "type": "boolean",
          "default": true,
          "description": "Include L3 persona (core) for the agent profile on recall."
        },
        "acp.memory.includeSceneNav": {
          "type": "boolean",
          "default": true,
          "description": "Include L2 scenario navigation index for the agent profile on recall."
        },
        "acp.memory.captureEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Write L0 conversation turns to MemoryCore after each prompt completes."
        },
        "acp.memory.timeoutMs": {
          "type": "number",
          "default": 15000,
          "minimum": 1000,
          "description": "HTTP timeout for MemoryCore Gateway requests (milliseconds)."
        },
        "acp.memory.debug": {
          "type": "boolean",
          "default": false,
          "description": "Verbose timing/debug logging for memory recall + injection (per-call latency, total recall time, injection-vs-prompt-send timing). Written to the 'ACP Client' output channel."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "lint": "eslint src --max-warnings 0",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "test": "vscode-test",
    "test:unit": "npm run compile-tests && mocha --ui tdd 'out/test/markdownMath.test.js' 'out/test/markdownBalance.test.js' 'out/test/linkifier.test.js' 'out/test/titleCleaner.test.js' 'out/test/toolCallTitleCleaner.test.js' 'out/test/streamCoalescer.test.js' 'out/test/cleanUserMessage.test.js' 'out/test/followAgent.test.js' 'out/test/memory.test.js' 'out/test/messageQueue.test.js' 'out/test/mergeInterruptedOrder.test.js' 'out/test/sessionCaptureRestore.test.js' 'out/test/memoryCacheStability.test.js' 'out/test/crewStageLabel.test.js' 'out/test/rawInputDirectoryTooltip.test.js' 'out/test/fallbackMessageId.test.js' 'out/test/diffPathsTooltip.test.js' 'out/test/agentDisplayName.test.js' 'out/test/formatAcpErrorMessage.test.js'",
    "deploy": "bash scripts/deploy-all.sh",
    "deploy:fast": "bash scripts/deploy-all.sh --skip-tests --skip-lint",
    "install:local": "bash scripts/install-vscode-server.sh",
    "install:server": "bash scripts/install-vscode-server-remote.sh",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.1.0",
    "@vscode/extension-telemetry": "^1.5.0",
    "katex": "^0.18.1",
    "marked": "^15.0.0",
    "mermaid": "^11.16.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.7.1",
    "eslint": "^9.0.0",
    "prettier": "^3.9.5",
    "ts-loader": "^9.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.0.0",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.0"
  }
}
